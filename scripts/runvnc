#!/bin/bash
# 启动 VNC 服务器（xfce4 桌面），保持容器前台运行
set -e

export HOME=/home/node
export USER=node
export DISPLAY="${DISPLAY:-:1}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

VNC_PASSWORD="${VNC_PASSWORD:-openclaw}"
VNC_RESOLUTION="${VNC_RESOLUTION:-1280x800}"
VNC_COL_DEPTH="${VNC_COL_DEPTH:-24}"
# tigervnc 1.15+ 的状态目录是 ~/.config/tigervnc（不再是旧的 ~/.vnc）
VNC_DIR="$HOME/.config/tigervnc"
VNC_PASSWD_FILE="$VNC_DIR/passwd"

mkdir -p "$VNC_DIR"

# 生成 TigerVNC 的 passwd 文件（经典 VNC DES 混淆格式，RealVNC/TigerVNC/TightVNC
# 通用）。这台镜像所用的 Ubuntu 26.04 源里 tigervnc-tools（提供 tigervncpasswd）
# 目前没有可安装的包，所以改用 openssl 按同样的固定密钥手工生成，
# 密钥是标准算法里固定字节 {23,82,107,6,35,78,88,7} 按位翻转后的结果。
gen_vnc_passwd() {
  local pass="$1" out="$2"
  local fixedkey_bitreversed="e84ad660c4721ae0"
  local tmp
  tmp="$(mktemp)"
  # 密码按经典 VNC 规则截断/补零到 8 字节
  printf '%s' "$pass" | head -c 8 > "$tmp"
  local size
  size=$(stat -c%s "$tmp")
  if [ "$size" -lt 8 ]; then
    dd if=/dev/zero bs=1 count=$((8 - size)) >> "$tmp" 2>/dev/null
  fi
  openssl enc -des-ecb -K "$fixedkey_bitreversed" -nosalt -nopad \
    -provider legacy -provider default \
    -in "$tmp" -out "$out"
  rm -f "$tmp"
  chmod 600 "$out"
}

# 每次启动都按 VNC_PASSWORD（默认 openclaw）重新生成密码文件，方便通过环境变量覆盖默认密码
gen_vnc_passwd "$VNC_PASSWORD" "$VNC_PASSWD_FILE"

# 清理上次异常退出遗留的锁文件/socket
vncserver -kill "$DISPLAY" >/dev/null 2>&1 || true
rm -rf "/tmp/.X${DISPLAY#:}-lock" "/tmp/.X11-unix/X${DISPLAY#:}"

vncserver "$DISPLAY" \
  -geometry "$VNC_RESOLUTION" \
  -depth "$VNC_COL_DEPTH" \
  -localhost no \
  -SecurityTypes VncAuth \
  -passwd "$VNC_PASSWD_FILE"

echo "VNC 服务器已启动: display $DISPLAY (端口 5901), 分辨率 ${VNC_RESOLUTION}x${VNC_COL_DEPTH}"

# 保持容器前台运行
exec tail -F "$VNC_DIR"/*.log
